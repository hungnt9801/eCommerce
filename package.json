{
  "name": "ecommerce",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "pnpm --filter @ecommerce/admin-web dev",
    "build": "pnpm --filter @ecommerce/admin-web build",
    "lint": "pnpm --filter @ecommerce/admin-web lint",
    "gen:api": "pnpm --filter @ecommerce/api-client gen",
    "spec:snapshot": "pnpm --filter @ecommerce/api-client spec:snapshot",
