<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Project test tự quản version package (không dùng central package management của solution)
         để version của test runner không ràng buộc các project sản phẩm. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- 🚨 VÁ LỖ HỔNG BẮC CẦU (phát hiện 14/10/2026): project test đặt
         ManagePackageVersionsCentrally=false nên BỎ QUA ghim ở Directory.Packages.props
         => resolve 10.0.11 (KHUYẾN NGHỊ BẢO MẬT NU1902/NU1903: 1 moderate + 3 high).
         Đây đúng là thư viện dùng cho XMLDSig (SIGN-001/EINV-001). Ghim tường minh ở đây
         để bản test dùng CÙNG phiên bản đã vá như code sản phẩm. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\eCommerce.Kernel\eCommerce.Kernel.csproj" />
    <ProjectReference Include="..\..\modules\Messaging\eCommerce.Messaging.Domain\eCommerce.Messaging.Domain.csproj" />
    <ProjectReference Include="..\..\modules\Address\eCommerce.Address.Domain\eCommerce.Address.Domain.csproj" />
    <!-- 🔑 `ADDR-004` phần B (`S2`): hợp đồng của miền địa chỉ (DTO snapshot + ETO) và entity sổ địa chỉ
         của khách — cần cho test bất biến của sổ + test `TC-18` (ETO không chứa PII). -->
    <ProjectReference Include="..\..\modules\Address\eCommerce.Address.Application.Contracts\eCommerce.Address.Application.Contracts.csproj" />
    <ProjectReference Include="..\..\modules\Customers\eCommerce.Customers.Domain\eCommerce.Customers.Domain.csproj" />
    <ProjectReference Include="..\..\modules\EInvoice\eCommerce.EInvoice.Domain\eCommerce.EInvoice.Domain.csproj" />
    <ProjectReference Include="..\..\modules\EInvoice\eCommerce.EInvoice.Application\eCommerce.EInvoice.Application.csproj" />
    <ProjectReference Include="..\..\modules\Signing\eCommerce.Signing.Domain\eCommerce.Signing.Domain.csproj" />
    <ProjectReference Include="..\..\src\eCommerce.Domain\eCommerce.Domain.csproj" />
    <ProjectReference Include="..\..\modules\ChannelHub\eCommerce.ChannelHub.Application\eCommerce.ChannelHub.Application.csproj" />
    <!-- Cần cho **test bất biến bằng reflection**: `ChannelAppService` (nút "Đồng bộ ngay") BẮT BUỘC
         phải đi qua cổng đồng bộ chung `IChannelShopSyncService` — biến thể thứ hai của lỗi #22. -->
    <ProjectReference Include="..\..\src\eCommerce.Application\eCommerce.Application.csproj" />
    <!-- 🚨 Cần cho **test bất biến quy ước #3**: entity của module nơi nhận đơn PHẢI có `DbSet` trên
         DbContext hợp nhất, nếu không `IRepository<T>` không được đăng ký (lỗi Phase 0). -->
    <ProjectReference Include="..\..\src\eCommerce.EntityFrameworkCore\eCommerce.EntityFrameworkCore.csproj" />
    <!-- 🚨 `WEB-001` muc 97.7 #1 — can tham chieu `eCommerce.Web` de test TRUC TIEP `MenuViewComponent`.
         📌 LY DO: loi "menu co nhom nhung KHONG render muc con" da lot qua 1101 unit test vi khong co
         test nao cham toi lop render. 🔑 Muon loi do KHONG TAI DIEN DUOC thi phai test CHINH lop render. -->
    <ProjectReference Include="..\..\src\eCommerce.Web\eCommerce.Web.csproj" />
    <ProjectReference Include="..\..\modules\PaymentHub\eCommerce.PaymentHub.Application\eCommerce.PaymentHub.Application.csproj" />
    <ProjectReference Include="..\..\modules\Tax\eCommerce.Tax.Domain\eCommerce.Tax.Domain.csproj" />
    <ProjectReference Include="..\..\modules\Pricing\eCommerce.Pricing.Domain\eCommerce.Pricing.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- 📌 Dữ liệu cho test `RangBuocDbChuaAnhXaTests` (danh sách trắng có lý do). Copy sang bin để test
         đọc được kể cả khi chạy từ thư mục build. -->
    <None Update="Data\RangBuocChuaAnhXa.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
