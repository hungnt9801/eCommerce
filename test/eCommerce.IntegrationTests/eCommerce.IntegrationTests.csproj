<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Như eCommerce.Tests: project test tự quản version package để không ràng buộc project sản phẩm. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- 🔒 GHIM version theo quyết định Q10 của XC-002 (bản mới nhất trên NuGet, tra 13/10/2026).
         Nếu KHÔNG ghim thì Testcontainers tự lấy image mới nhất ⇒ test có thể đỏ vì lý do ngoài code. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- 🔑 `S4` — `PayTransactionsChanTrungTests` khoá **định dạng `MerchantReference`** (`SinhMaThamChieu`) vào
         **độ dài cột thật** (64). 📌 Chỉ cần tầng **Domain** của module thanh toán (hàm sinh mã là **hàm thuần**),
         không cần DbContext/Host ⇒ nhóm test này vẫn nhẹ (raw SQL + hàm thuần). -->
    <ProjectReference Include="..\..\modules\PaymentHub\eCommerce.PaymentHub.Domain\eCommerce.PaymentHub.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Schema sinh từ CHÍNH migration thật:
           dotnet ef migrations script -p src\eCommerce.EntityFrameworkCore -s src\eCommerce.DbMigrator -o test\eCommerce.IntegrationTests\Assets\schema.sql
         ⇒ test chạy trên ĐÚNG schema sẽ triển khai, không phải schema tự viết lại. -->
    <None Include="Assets\schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
