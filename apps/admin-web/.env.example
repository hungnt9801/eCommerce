# ══════════════════════════════════════════════════════════════════════════════════════════════════
# Web Admin (Next.js BFF) — mẫu biến môi trường. Sao chép thành `.env.local` cho máy dev.
#
#   Copy-Item apps\admin-web\.env.example apps\admin-web\.env.local
#
# 📌 `.env.local` bị gitignore. Tệp NÀY là danh sách **đầy đủ** biến mà BFF đọc — thêm biến mới thì
#    thêm ở đây, nếu không phiên sau sẽ không biết phải đặt gì khi deploy.
# ══════════════════════════════════════════════════════════════════════════════════════════════════

# ── ① BFF → API Host (chỉ SERVER đọc — D-12) ───────────────────────────────────────────────────────
# 🚨 Dev dùng HTTP 54275 (D-16). Đừng dùng https 54274: cert self-signed ⇒ Node fetch lỗi.
# 🚨 Trong CONTAINER (`docker compose`, WP-10) `localhost` là chính container ⇒ compose đặt
#    `http://host.docker.internal:54275`. Đừng chép giá trị `localhost` vào đó rồi báo "API chết".
API_BASE_URL=http://localhost:54275

# ── ② OpenIddict client (seed dev — đổi ở production) ──────────────────────────────────────────────
OAUTH_CLIENT_ID=eCommerce_App
OAUTH_CLIENT_SECRET=1q2w3e*
OAUTH_SCOPE=eCommerce offline_access

# ── ③ Issuer cấp token ─────────────────────────────────────────────────────────────────────────────
# 📌 Để TRỐNG ⇒ dùng `API_BASE_URL` (giữ nguyên hành vi N1…N10). Đặt riêng khi API nằm sau gateway
#    nội bộ mà issuer công khai khác địa chỉ gọi API. KHÔNG có dấu `/` ở cuối.
AUTH_ISSUER=http://localhost:54275

# ── ④ Auth.js (BẮT BUỘC đổi khi deploy: chuỗi ngẫu nhiên ≥ 32 ký tự) ───────────────────────────────
# 🔒 `AUTH_SECRET` KHÔNG được có tiền tố NEXT_PUBLIC_ — nó là khoá ký cookie session.
AUTH_SECRET=dev-only-auth-secret-doi-o-production
AUTH_TRUST_HOST=true

# ── ⑤ Công khai (NHÚNG LÚC BUILD — đổi giá trị phải BUILD LẠI) ────────────────────────────────────────
# 📌 Tên hiển thị trên sidebar/tiêu đề trang. Không phải bí mật ⇒ được ra trình duyệt.
# ⚠️ Đặt biến này bằng `environment:` của compose KHÔNG có tác dụng (phải qua `build.args`) —
#    đó là lý do `docker-compose.yml` truyền nó ở `build.args`.
NEXT_PUBLIC_APP_NAME=eCommerce

# ── ⑥ Danh nghiệp mặc định (path segment) ───────────────────────────────────────────────────────────
DEFAULT_BUSINESS=230222

# ── ⑦ Health check `/api/health` (WP-10) ───────────────────────────────────────────────────────────
# Trần chờ `/health-status` của Host (ms). Không có trần thì Host TREO làm health treo theo.
HEALTH_TIMEOUT_MS=3000
