<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>eCommerce</RootNamespace>
    <AssemblyName>eCommerce.HttpApi.Host</AssemblyName>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\eCommerce.EntityFrameworkCore\eCommerce.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\eCommerce.Application\eCommerce.Application.csproj" />
    <ProjectReference Include="..\..\modules\Address\eCommerce.Address.Application\eCommerce.Address.Application.csproj" />
    <ProjectReference Include="..\..\modules\EInvoice\eCommerce.EInvoice.Application\eCommerce.EInvoice.Application.csproj" />
    <ProjectReference Include="..\..\modules\Signing\eCommerce.Signing.Application\eCommerce.Signing.Application.csproj" />
    <ProjectReference Include="..\..\modules\Pricing\eCommerce.Pricing.Application\eCommerce.Pricing.Application.csproj" />
    <ProjectReference Include="..\..\modules\Customers\eCommerce.Customers.Application\eCommerce.Customers.Application.csproj" />
    <ProjectReference Include="..\..\modules\ChannelHub\eCommerce.ChannelHub.Application\eCommerce.ChannelHub.Application.csproj" />
    <ProjectReference Include="..\..\modules\PaymentHub\eCommerce.PaymentHub.Application\eCommerce.PaymentHub.Application.csproj" />
    <ProjectReference Include="..\..\modules\Tax\eCommerce.Tax.EntityFrameworkCore\eCommerce.Tax.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Autofac" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" />
    <PackageReference Include="Volo.Abp.OpenIddict.AspNetCore" />
    <PackageReference Include="Volo.Abp.Swashbuckle" />
    <PackageReference Include="Volo.Abp.Caching.StackExchangeRedis" />
    <PackageReference Include="Volo.Abp.DistributedLocking" />
    <PackageReference Include="Volo.Abp.BackgroundWorkers" />
    <!-- 🚨 2 gói BẮT BUỘC (xem ghi chú trong Directory.Packages.props): SignInManager cho password grant
         + default challenge scheme để trả 401 thay vì 500. -->
    <PackageReference Include="Volo.Abp.Identity.AspNetCore" />
    <PackageReference Include="Volo.Abp.AspNetCore.Authentication.JwtBearer" />
    <!-- 🚨 `INV-003`/`REC-001` — **ĐƯỜNG GHI CHUẨN CHO ADMIN** (mục 5 việc 4 của gói bàn giao): endpoint
         `setting-management/*` để đổi setting QUA API ⇒ `ISettingManager` **tự xoá cache** (cả Redis **và**
         cache trong bộ nhớ tiến trình). Thiếu gói này thì swagger **không** có route `setting` ⇒ phải sửa
         `AbpSettings` bằng SQL + xoá cache tay = **đúng cái bẫy đã làm SAI 4 phép đo** (`inv-003` §16.6). -->
    <PackageReference Include="Volo.Abp.SettingManagement.HttpApi" />
    <PackageReference Include="DistributedLock.Redis" />
  </ItemGroup>

</Project>
