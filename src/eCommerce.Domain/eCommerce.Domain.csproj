<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>eCommerce</RootNamespace>
    <AssemblyName>eCommerce.Domain</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\eCommerce.Domain.Shared\eCommerce.Domain.Shared.csproj" />
    <!-- 📌 `Kernel` là thư viện DÙNG CHUNG (`Money`, mã khoá, metric) và **không** phụ thuộc dự án nào
         ⇒ tham chiếu từ Domain KHÔNG tạo vòng lặp. Cần cho `InventoryReconciliationService` phát metric
         `inventory_recon_mismatch_skus` (`INV-001` ADR-10). -->
    <ProjectReference Include="..\..\shared\eCommerce.Kernel\eCommerce.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AuditLogging.Domain" />
    <PackageReference Include="Volo.Abp.BackgroundJobs.Domain" />
    <PackageReference Include="Volo.Abp.Ddd.Domain" />
    <!-- 🚨 Cần cho `CategoryTreeService` (`CAT-002` D8): thao tác DI CHUYỂN NHÁNH phải giành khoá phân tán
         theo tenant + kiểm tra chu trình trong cùng transaction. Tiền lệ đã có: `Messaging.Domain`
         cũng tham chiếu gói này (xem `<PackageReference>` tương ứng trong csproj của nó). -->
    <PackageReference Include="Volo.Abp.DistributedLocking" />
    <PackageReference Include="Volo.Abp.FeatureManagement.Domain" />
    <PackageReference Include="Volo.Abp.Identity.Domain" />
    <PackageReference Include="Volo.Abp.OpenIddict.Domain" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Domain" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Domain.Identity" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Domain.OpenIddict" />
    <PackageReference Include="Volo.Abp.SettingManagement.Domain" />
  </ItemGroup>

</Project>
