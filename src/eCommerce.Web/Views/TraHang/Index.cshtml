@using eCommerce.Sales.Dtos
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@model List<OrderReturnDto>
@{
    PageLayout.Content.Title = "Phiếu trả hàng (RMA)";
    PageLayout.Content.BreadCrumb.Add("Trang chủ");
    PageLayout.Content.BreadCrumb.Add("Vận hành");
    PageLayout.Content.BreadCrumb.Add("Phiếu trả hàng");

    var donId = ViewBag.DonId as Guid?;
    var thongBao = ViewBag.ThongBao as string;
    var loi = ViewBag.Loi as string;
    var coQuyenDuyet = ViewBag.CoQuyenDuyet as bool? ?? false;
    var coQuyenNhan = ViewBag.CoQuyenNhan as bool? ?? false;
    var coQuyenHuy = ViewBag.CoQuyenHuy as bool? ?? false;
    var soDon = ViewBag.SoDon as Dictionary<Guid, string> ?? new Dictionary<Guid, string>();

    bool DaKetThuc(string status) => status is "Closed" or "Rejected" or "Cancelled";
}

@* 🆕 `S14` PHẦN E — MÀN HÌNH PHIẾU TRẢ HÀNG (RMA), `SAL-006` §32.

   🔒 VÌ SAO PHẢI CÓ MÀN HÌNH NÀY (không chỉ API): app service `IOrderReturnAppService` đã có từ phần B và
   đã có chứng từ kho ở phần C — nhưng **không có lối vào** nghĩa là không ai duyệt, không ai nhận hàng,
   không ai đóng phiếu ⇒ quy trình RMA **không chạy được** dù mọi tầng dưới đã đúng. 📌 Cùng loại nợ đã gặp
   ở `INV-003` §16.6 / `REC-001` §18 / `S13` (đường ghi đúng mà không có lối vào).

   ✅ HAI TRỤC PHẢI THẤY RIÊNG: `Status` (thủ tục) và `GoodsStatus` (hàng đã về chưa). Gộp lại thì mất đúng
   trạng thái vận hành phổ biến nhất — *"đã duyệt nhưng hàng chưa về"* — và dễ hoàn tiền/hoàn kho sai.

   🚨 MỌI form POST có `@Html.AntiForgeryToken()` (bài học vòng 65/86). Mã lỗi nghiệp vụ hiện **nguyên văn**
   (`eCommerce:Sales:0010` …) qua `TempData` — server bắt `BusinessException`, **không** để thành `500`.

   📌 NEO `[TRAHANG-MAN-HINH]` là ASCII THUẦN và nằm NGOÀI chú thích này (Razor KHÔNG render khối chú thích) —
   `ViewAnchorTests` + E2E dùng nó để phân biệt *"trang RMA đã render"* với một trang khác trả `200`. *@

<h1>Phiếu trả hàng (RMA) <span class="badge bg-secondary">nội bộ</span></h1>

<p class="text-muted">
    <span class="badge bg-light text-dark">[TRAHANG-MAN-HINH]</span>
    Mỗi phiếu có <strong>hai trục độc lập</strong>: <code>Status</code> (thủ tục duyệt) và
    <code>GoodsStatus</code> (hàng đã về kho chưa). 🔒 Phiếu <em>đã duyệt nhưng hàng chưa về</em> thì
    <strong>chưa</strong> được hoàn tiền và <strong>chưa</strong> được đóng.
</p>

@if (!string.IsNullOrWhiteSpace(thongBao))
{
    <div class="alert alert-success" id="thong-bao-tra-hang">@thongBao</div>
}
@if (!string.IsNullOrWhiteSpace(loi))
{
    <div class="alert alert-danger" id="loi-tra-hang">@loi</div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="donId" value="@donId" class="form-control" placeholder="Mã đơn (GUID) — để trống để xem tất cả" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Lọc</button>
    </div>
    @if (donId is not null)
    {
        <div class="col-auto">
            <a class="btn btn-outline-secondary" asp-action="Index">Bỏ lọc</a>
        </div>
    }
</form>

<p class="text-muted">
    Tổng: <strong>@Model.Count</strong> phiếu@(donId is { } locDon
        ? $" của đơn {soDon.GetValueOrDefault(locDon, locDon.ToString()[..8])}"
        : "").
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Chưa có phiếu trả nào khớp bộ lọc.</div>
}
else
{
    <table class="table table-sm table-striped align-middle" id="bang-phieu-tra">
        <thead>
            <tr>
                <th>Mã phiếu</th>
                <th>Đơn</th>
                <th>Kênh</th>
                <th>Trạng thái</th>
                <th>Hàng</th>
                <th class="text-end">Đã hoàn</th>
                <th class="text-end">Số dòng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><code>@r.ReturnNumber</code></td>
                    <td>
                        @* 🔑 Trỏ tới trang đơn bằng `Url.Action` (không viết cứng href) *@
                        <a href="@Url.Action("ChiTiet", "DonHang", new { id = r.OrderId })">
                            @soDon.GetValueOrDefault(r.OrderId, r.OrderId.ToString()[..8])
                        </a>
                    </td>
                    <td><code>@r.ChannelCode</code></td>
                    <td>@r.Status</td>
                    <td>@r.GoodsStatus</td>
                    <td class="text-end">@r.RefundedAmount.ToString("N0") @r.RefundCurrency</td>
                    <td class="text-end">@r.Lines.Count</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h4 mt-4">Xử lý phiếu</h2>

@if (Model.Count == 0)
{
    <p class="text-muted">Không có phiếu để xử lý.</p>
}

@foreach (var r in Model)
{
    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap gap-2 align-items-center">
            <strong>@r.ReturnNumber</strong>
            <span class="badge bg-dark">@r.Status</span>
            <span class="badge bg-info text-dark">Hàng: @r.GoodsStatus</span>
            <span class="text-muted small">
                đơn @soDon.GetValueOrDefault(r.OrderId, r.OrderId.ToString()[..8]) · kênh @r.ChannelCode ·
                lý do <code>@r.ReasonCode</code>
                @if (!string.IsNullOrWhiteSpace(r.ReasonText))
                {
                    <text> — @r.ReasonText</text>
                }
            </span>
        </div>
        <div class="card-body">
            @if (r.Lines.Count > 0)
            {
                <table class="table table-sm mb-3">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th class="text-end">Số lượng trả</th>
                            <th class="text-end">Đã nhận</th>
                            <th class="text-end">Tiền hoàn dòng</th>
                            <th>Cách xử lý</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in r.Lines)
                        {
                            <tr>
                                <td>@d.Sku</td>
                                <td class="text-end">@d.Quantity</td>
                                <td class="text-end">@d.ReceivedQuantity</td>
                                <td class="text-end">@d.RefundAmount.ToString("N0")</td>
                                <td>@d.Disposition</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (DaKetThuc(r.Status))
            {
                <p class="text-muted mb-0">
                    Phiếu đã kết thúc (<code>@r.Status</code>) ⇒ không còn thao tác. 📌 Nhật ký chuyển trạng thái
                    là <strong>append-only</strong> — không sửa/xoá được (chứng từ khi tranh chấp).
                </p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2 align-items-start">
                    @if (r.Status == "Requested")
                    {
                        @if (coQuyenDuyet)
                        {
                            <form method="post" asp-action="Duyet" class="border rounded p-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                @if (donId is { } loc1)
                                {
                                    <input type="hidden" name="donId" value="@loc1" />
                                }
                                <button type="submit" class="btn btn-sm btn-success" id="nut-duyet-@r.Id">
                                    Duyệt phiếu
                                </button>
                            </form>

                            <form method="post" asp-action="TuChoi" class="border rounded p-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                @if (donId is { } loc2)
                                {
                                    <input type="hidden" name="donId" value="@loc2" />
                                }
                                <label class="form-label small mb-1">Lý do từ chối (bắt buộc)</label>
                                <input name="lyDo" class="form-control form-control-sm" required minlength="3" maxlength="512" />
                                <button type="submit" class="btn btn-sm btn-outline-danger mt-1" id="nut-tu-choi-@r.Id">
                                    Từ chối
                                </button>
                            </form>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                Thiếu quyền <code>eCommerce.Orders.Return.Approve</code> ⇒ không duyệt/từ chối được.
                            </p>
                        }
                    }

                    @if (r.Status == "Approved")
                    {
                        @if (coQuyenNhan)
                        {
                            <form method="post" asp-action="NhanHang" class="border rounded p-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                @if (donId is { } loc3)
                                {
                                    <input type="hidden" name="donId" value="@loc3" />
                                }
                                <p class="small mb-2">
                                    Nhận <strong>cả phiếu trong một lần</strong>: mỗi dòng nhập số nhận và cách xử lý.
                                    🔒 Chỉ dòng <code>Restock</code> mới được nhập lại kho (chứng từ <code>CustomerReturn</code>).
                                </p>
                                <table class="table table-sm align-middle mb-2">
                                    <thead>
                                        <tr>
                                            <th>SKU</th>
                                            <th class="text-end">Trả</th>
                                            <th class="text-end">Đã nhận</th>
                                            <th style="width:8rem">Nhận lần này</th>
                                            <th style="width:14rem">Cách xử lý</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in r.Lines)
                                        {
                                            <tr>
                                                <td>
                                                    @d.Sku
                                                    <input type="hidden" name="dongTraId" value="@d.Id" />
                                                </td>
                                                <td class="text-end">@d.Quantity</td>
                                                <td class="text-end">@d.ReceivedQuantity</td>
                                                <td>
                                                    @* ⚠️ min = 1: `ReceivedQuantity = 0` + `Disposition` vi phạm CHECK của DB *@
                                                    <input type="number" name="soLuongNhan" min="1" max="@d.Quantity"
                                                           value="@d.Quantity" class="form-control form-control-sm" required />
                                                </td>
                                                <td>
                                                    <select name="xuLy" class="form-select form-select-sm">
                                                        <option value="Restock">Restock — nhập lại kho</option>
                                                        <option value="Damaged">Damaged — hỏng</option>
                                                        <option value="ReturnToSupplier">ReturnToSupplier — trả NCC</option>
                                                    </select>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <button type="submit" class="btn btn-sm btn-primary" id="nut-nhan-hang-@r.Id">
                                    Nhận hàng
                                </button>
                            </form>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                Thiếu quyền <code>eCommerce.Orders.Manage</code> ⇒ không ghi nhận hàng hoàn được.
                            </p>
                        }
                    }

                    @if (r.Status == "Received")
                    {
                        @if (coQuyenNhan)
                        {
                            <form method="post" asp-action="Dong" class="border rounded p-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                @if (donId is { } loc4)
                                {
                                    <input type="hidden" name="donId" value="@loc4" />
                                }
                                <button type="submit" class="btn btn-sm btn-dark" id="nut-dong-@r.Id">
                                    Đóng phiếu
                                </button>
                            </form>
                        }
                    }

                    @* 🆕 `S14G` — HUỶ PHIẾU (`SAL-006` §34; nợ §32.5 #3). 🔑 `HuyAsync` đã có từ `S14B` nhưng
                       **không có lối vào** ⇒ khách đổi ý thì phiếu trả **không rút lại được**.

                       🔒 Điều kiện hiện nút **chép đúng guard của entity** (`OrderReturn.Huy`): phiếu chưa kết
                       thúc **và** `GoodsStatus` KHÔNG phải `Received`/`PartiallyReceived` — đã nhận hàng thì phải
                       nhận đủ rồi đóng, **không** huỷ. 📌 `Requested` **và** `Approved` đều huỷ được (API cho
                       phép); ẩn nút **không phải** là bảo vệ — `HuyAsync` mới là nơi cưỡng chế. *@
                    @if (coQuyenHuy && (r.Status is "Requested" or "Approved")
                         && r.GoodsStatus is not ("Received" or "PartiallyReceived"))
                    {
                        <form method="post" asp-action="Huy" class="border rounded p-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            @if (donId is { } locHuy)
                            {
                                <input type="hidden" name="donId" value="@locHuy" />
                            }
                            <label class="form-label small mb-1">Lý do huỷ (bắt buộc)</label>
                            <input name="lyDo" class="form-control form-control-sm" required minlength="3" maxlength="512" />
                            <button type="submit" class="btn btn-sm btn-outline-warning mt-1" id="nut-huy-@r.Id">
                                Huỷ phiếu
                            </button>
                        </form>
                    }

                    @if (coQuyenDuyet)
                    {
                        <form method="post" asp-action="GhiNhanHoanTien" class="border rounded p-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            @if (donId is { } loc5)
                            {
                                <input type="hidden" name="donId" value="@loc5" />
                            }
                            <label class="form-label small mb-1">Ghi nhận đã hoàn tiền (thủ công)</label>
                            <input name="soTien" type="number" step="0.01" min="0.01" class="form-control form-control-sm" required />
                            <button type="submit" class="btn btn-sm btn-outline-primary mt-1" id="nut-hoan-tien-@r.Id">
                                Ghi nhận hoàn tiền
                            </button>
                        </form>
                    }
                </div>

                <p class="text-muted small mt-3 mb-0">
                    🔒 Hoàn tiền ở đây chỉ <strong>ghi nhận</strong> (<code>Q4</code>) — <strong>không</strong> tự gọi
                    cổng thanh toán. Đường gọi cổng là <code>PAY-001</code> (<code>RefundAsync</code>, có duyệt +
                    idempotency), mở từ <code>S14b</code>.
                </p>
            }
        </div>
    </div>
}
