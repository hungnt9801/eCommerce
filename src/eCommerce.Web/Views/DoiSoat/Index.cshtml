@using eCommerce.Inventory
@using Volo.Abp.Application.Dtos
@model PagedResultDto<LuotDoiSoatDto>
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = "Đối soát tồn kho";
    PageLayout.Content.BreadCrumb.Add("Trang chủ");
    PageLayout.Content.BreadCrumb.Add("Đối soát tồn kho");

    bool chiConViec = ViewBag.ChiConViec ?? false;
    bool chiChoXacNhan = ViewBag.ChiChoXacNhan ?? false;
    int trang = ViewBag.Trang ?? 1;
    int soMoiTrang = ViewBag.SoMoiTrang ?? 20;
    var thongBaoDoiSoat = TempData["ThongBaoDoiSoat"] as string;
    var loiDoiSoat = TempData["LoiXacNhan"] as string;
}

@if (!string.IsNullOrWhiteSpace(thongBaoDoiSoat))
{
    <div class="alert alert-success">@thongBaoDoiSoat</div>
}
@if (!string.IsNullOrWhiteSpace(loiDoiSoat))
{
    <div class="alert alert-danger">@loiDoiSoat</div>
}

@* 🚨 `REC-001` — LỊCH SỬ LƯỢT QUÉT ĐỐI SOÁT.

   📌 VÌ SAO MÀN HÌNH NÀY TỒN TẠI: `ReconRuns` đã có **14 lượt thật** trong DB nhưng **không có đường đọc**
   nào cho người vận hành ⇒ lệch tồn kho được **phát hiện rồi nằm im**. Xem `rec-001` §16.8 và §17.

   🔒 Điểm quan trọng nhất của màn hình: **`SoLechChuaXuLy`** — con số **HÀNH ĐỘNG ĐƯỢC**.
   Nếu chỉ hiện tổng `SoLech`, danh sách **mãi** hiện như cũ và **không ai đọc nữa**. *@

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0">Lịch sử lượt quét đối soát</h4>
    <div class="d-flex gap-2 flex-wrap">
        @if (chiConViec)
        {
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-chiChoXacNhan="@chiChoXacNhan">Hiện tất cả</a>
        }
        else
        {
            <a class="btn btn-sm btn-outline-warning" asp-action="Index" asp-route-chiConViec="true" asp-route-chiChoXacNhan="@chiChoXacNhan">Chỉ lượt còn việc</a>
        }
        @* 🆕 `S7` — *"hộp việc"* của người có quyền `eCommerce.Reconciliation.Confirm`. *@
        @if (chiChoXacNhan)
        {
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-chiConViec="@chiConViec">Bỏ lọc chờ xác nhận</a>
        }
        else
        {
            <a class="btn btn-sm btn-outline-danger" asp-action="Index" asp-route-chiChoXacNhan="true" asp-route-chiConViec="@chiConViec">Chỉ lượt CHỜ XÁC NHẬN</a>
        }
    </div>
</div>

@if (Model.TotalCount == 0)
{
    @* ⚠️ Trạng thái RỖNG phải NÓI RÕ vì sao — nếu chỉ để trắng, người dùng không phân biệt được
       "hệ thống khoẻ" với "tính năng hỏng". *@
    <div class="alert alert-info">
        <strong>Không có lượt đối soát nào</strong> khớp bộ lọc hiện tại.
        @if (chiConViec)
        {
            <span>Đây là tin <strong>tốt</strong>: không lượt nào còn dòng lệch chưa xử lý. </span>
            <a asp-action="Index">Xem tất cả lượt</a>
        }
        else
        {
            <span>Job đối soát có thể chưa chạy lần nào.</span>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Bắt đầu (UTC)</th>
                    <th class="text-end">Giây</th>
                    <th class="text-end">Cặp đã đo</th>
                    <th class="text-end">Lệch</th>
                    <th class="text-end">Vượt ngưỡng</th>
                    <th class="text-end">Chưa xử lý</th>
                    <th>Chính sách (ngưỡng)</th>
                    <th>Kết luận</th>
                    <th>Xác nhận</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var luot in Model.Items)
                {
                    @* 🔒 Tô đậm dòng CÒN VIỆC: người trực quét mắt qua bảng phải thấy ngay việc cần làm. *@
                    var conViec = luot.SoLechChuaXuLy > 0;
                    <tr class="@(conViec ? "table-warning" : "")">
                        <td>@luot.BatDauUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="text-end">@luot.SoGiayQuet.ToString("0.0")</td>
                        <td class="text-end">@luot.SoCapDaDo</td>
                        <td class="text-end">@luot.SoLech</td>
                        <td class="text-end">
                            @luot.SoLechVuotNguong
                            @if (luot.CoVuotNguong)
                            {
                                <span class="badge bg-danger ms-1">vượt</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (conViec)
                            {
                                <span class="badge bg-warning text-dark">@luot.SoLechChuaXuLy</span>
                            }
                            else
                            {
                                <span class="text-success">0</span>
                            }
                        </td>
                        <td class="small">
                            @luot.DonViNguong @luot.GiaTriNguong · @luot.HanhDong
                            @if (!luot.NguongHopLe)
                            {
                                @* 🚨 Cấu hình SAI, KHÔNG phải "kho lệch nhiều" — nói rõ để người đọc
                                   không đi tìm nguyên nhân ở kho. *@
                                <span class="badge bg-dark ms-1" title="Ngưỡng KHÔNG hợp lệ tại thời điểm quét ⇒ mọi lệch bị coi là vượt ngưỡng">ngưỡng SAI</span>
                            }
                        </td>
                        <td class="small">@luot.KetLuan</td>
                        @* 🆕 `S7` — TRẠNG THÁI XÁC NHẬN. 🔒 Ba trạng thái **phân biệt được**:
                           *chờ xác nhận* (việc cần làm) · *đã xác nhận* (bằng chứng: ai + khi nào) · *không cần*. *@
                        <td class="small">
                            @if (luot.DaXacNhan)
                            {
                                <span class="badge bg-success">đã xác nhận</span>
                                <div class="text-muted">
                                    @* 🔒 TÊN người xác nhận (tra ở app service) — 📌 nếu không tra được thì hiện
                                       GUID rút gọn + nói RÕ "không tra được tên", KHÔNG hiện "(không rõ)"
                                       (mất khả năng phân biệt *"tài khoản đã bị xoá cứng"* với *"lỗi tra cứu"*). *@
                                    <code class="text-muted">[DOISOAT-NGUOI-XAC-NHAN]</code>
                                    @if (!string.IsNullOrWhiteSpace(luot.ConfirmedByName))
                                    {
                                        <strong>@luot.ConfirmedByName</strong>
                                    }
                                    else
                                    {
                                        <code title="Không tra được tên từ AbpUsers — GUID vẫn là nguồn sự thật">@(luot.ConfirmedByUserId?.ToString("N").Substring(0, 8))…</code>
                                        <span class="small">(không tra được tên)</span>
                                    }
                                    · @luot.ConfirmedAtUtc?.ToString("yyyy-MM-dd HH:mm") UTC
                                </div>
                                <div class="text-muted">@luot.ConfirmNote</div>
                            }
                            else if (luot.ChoXacNhan)
                            {
                                <span class="badge bg-danger">chờ xác nhận</span>
                            }
                            else
                            {
                                <span class="text-muted">— không cần</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="ChiTiet" asp-route-id="@luot.Id">Xem lệch</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">Tổng @Model.TotalCount lượt · trang @trang</span>
        <div>
            @if (trang > 1)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index"
                   asp-route-chiConViec="@chiConViec" asp-route-chiChoXacNhan="@chiChoXacNhan" asp-route-trang="@(trang - 1)">« Trước</a>
            }
            @if (trang * soMoiTrang < Model.TotalCount)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index"
                   asp-route-chiConViec="@chiConViec" asp-route-chiChoXacNhan="@chiChoXacNhan" asp-route-trang="@(trang + 1)">Sau »</a>
            }
        </div>
    </div>
}

@* 🆕 `S7` — **RETENTION** (`REC-001` §17.8 #1: *"bảng chỉ tăng"*).
   🔒 Thao tác này **KHÔNG hoàn tác được** trên dữ liệu là **chứng từ** ⇒ mặc định là **XEM TRƯỚC**,
   nút xoá thật có `confirm`, và luật *cái gì không bao giờ bị xoá* được **in ngay trên màn hình**
   (📌 người bấm phải biết trước, không phải đọc mã nguồn).
   📌 Số ngày lấy từ setting `Recon.Retention.Days` (cấu hình ở `/HanMucKenh`); ô ở đây chỉ **ghi đè một lần**. *@
<div class="card mt-3">
    <div class="card-header"><strong>Dọn lịch sử theo chính sách lưu trữ (retention)</strong></div>
    <div class="card-body">
        <p class="text-muted small mb-2">
            🔒 <strong>Không bao giờ bị xoá:</strong> lượt quét (<code>ReconRuns</code>) · dòng lệch <strong>chưa xử lý</strong> ·
            dòng lệch của lượt <strong>đang chờ xác nhận</strong>. Chỉ dòng lệch <strong>đã xử lý</strong> và cũ hơn mốc mới bị dọn.
            <span class="text-muted">[DOISOAT-RETENTION]</span>
        </p>
        <form method="post" asp-action="DonDep" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label class="form-label">Số ngày lưu trữ (trống = theo chính sách)</label>
                <input class="form-control form-control-sm" type="number" min="1" max="36500" name="soNgay" placeholder="(theo setting)" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-sm btn-outline-secondary w-100" type="submit" name="chiXemTruoc" value="true">Xem trước (không xoá)</button>
            </div>
            <div class="col-md-3">
                <button class="btn btn-sm btn-outline-danger w-100" type="submit" name="chiXemTruoc" value="false"
                        onclick="return confirm('XOÁ THẬT các dòng lệch ĐÃ XỬ LÝ cũ hơn mốc. Không hoàn tác được. Tiếp tục?');">
                    Dọn thật
                </button>
            </div>
        </form>
    </div>
</div>
