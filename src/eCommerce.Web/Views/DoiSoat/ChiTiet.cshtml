@using eCommerce.Inventory
@model eCommerce.Web.Controllers.DoiSoatChiTietDto
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = "Dòng lệch đối soát";
    PageLayout.Content.BreadCrumb.Add("Trang chủ");
    PageLayout.Content.BreadCrumb.Add("Đối soát tồn kho");
    PageLayout.Content.BreadCrumb.Add("Dòng lệch");

    bool chiChuaXuLy = ViewBag.ChiChuaXuLy ?? true;
    int trang = ViewBag.Trang ?? 1;
    int soMoiTrang = ViewBag.SoMoiTrang ?? 50;
    var thongBaoDoiSoat = TempData["ThongBaoDoiSoat"] as string;
}

@* 🚨 `REC-001` — DÒNG LỆCH CỦA MỘT LƯỢT + Ô XỬ LÝ.

   🔒 BA BẤT BIẾN ĐƯỢC THỂ HIỆN Ở MÀN HÌNH NÀY (xem `rec-001` §17.3):
     ① `OnHand`/`TongSoCai`/`ChenhLech` là **ẢNH CHỤP lúc quét** ⇒ hiện dạng **chỉ đọc**, KHÔNG có ô sửa
        (sửa là **phá bằng chứng**);
     ② Xử lý lệch **BẮT BUỘC có lý do** ⇒ ô `lyDo` có `required`, và app service **NÉM** nếu thiếu;
     ③ Gọi lại **KHÔNG ghi đè** bằng chứng ⇒ dòng đã xử lý **không** hiện form nữa. *@

<h4 class="mb-1">Dòng lệch — lượt @Model.Luot.BatDauUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</h4>
<p class="text-muted small mb-3">
    @Model.Luot.SoCapDaDo cặp đã đo · @Model.Luot.SoLech lệch · @Model.Luot.SoLechVuotNguong vượt ngưỡng ·
    còn <strong>@Model.Luot.SoLechChuaXuLy</strong> dòng chưa xử lý ·
    chính sách <code>@Model.Luot.DonViNguong @Model.Luot.GiaTriNguong</code> / <code>@Model.Luot.HanhDong</code>
    @if (!Model.Luot.NguongHopLe)
    {
        <span class="badge bg-dark ms-1">ngưỡng SAI tại thời điểm quét</span>
    }
</p>

<div class="mb-3">
    @if (chiChuaXuLy)
    {
        <a class="btn btn-sm btn-outline-secondary" asp-action="ChiTiet" asp-route-id="@Model.Luot.Id" asp-route-chiChuaXuLy="false">Hiện cả dòng đã xử lý</a>
    }
    else
    {
        <a class="btn btn-sm btn-outline-warning" asp-action="ChiTiet" asp-route-id="@Model.Luot.Id" asp-route-chiChuaXuLy="true">Chỉ dòng chưa xử lý</a>
    }
    <a class="btn btn-sm btn-outline-primary" asp-action="Index">« Danh sách lượt</a>
</div>

@* 🚨 HIỆN LỖI NGHIỆP VỤ Ở ĐÂY (không phải trang lỗi 500).

   📌 VÌ SAO CẦN: `POST /DoiSoat/XuLyLech` thiếu lý do ⇒ `AbpExceptionFilter` biến `BusinessException`
   thành **`500` + "An internal error occurred…"** ⇒ người dùng **KHÔNG BIẾT** mình thiếu gì.
   Controller nay **bắt `BusinessException`** và đưa thông điệp vào `TempData` ⇒ hiện tại chỗ.

   🔒 Và đây **KHÔNG** phải "nuốt guard": lỗi vẫn **dừng** thao tác và **không ghi gì** — chỉ **đổi chỗ hiện**
   từ "trang lỗi hệ thống" sang "thông báo cho người dùng". Xem `rec-001` §18. *@
@if (TempData["LoiXuLyLech"] is string loiXuLy && !string.IsNullOrWhiteSpace(loiXuLy))
{
    <div class="alert alert-danger">
        <strong>Không xử lý được lệch.</strong> @loiXuLy
    </div>
}
@if (TempData["LoiXacNhan"] is string loiXacNhan && !string.IsNullOrWhiteSpace(loiXacNhan))
{
    <div class="alert alert-danger">
        <strong>Không xác nhận được lượt.</strong> @loiXacNhan
    </div>
}
@if (!string.IsNullOrWhiteSpace(thongBaoDoiSoat))
{
    <div class="alert alert-success">@thongBaoDoiSoat</div>
}

@* 🆕 `S7` — KHỐI XÁC NHẬN LƯỢT (quyết định `Q5` = A).
   🔒 Chỉ hiện khi lượt **ĐANG CHỜ** xác nhận (`VuotCanXacNhan` + chưa xác nhận). Ba trạng thái phải
   **phân biệt được**, vì *"không cần xác nhận"* và *"đã xác nhận"* dẫn tới hai hành động khác nhau.
   📌 Ở đây ghi rõ **xác nhận KHÔNG sửa tồn kho** — nếu không, người dùng tưởng bấm nút là hệ thống tự
   điều chỉnh lệch (đúng phương án đã **BỊ LOẠI** ở `Q5`). *@
@if (Model.Luot.DaXacNhan)
{
    <div class="alert alert-success" id="doisoat-xac-nhan">
        <strong>Đã xác nhận</strong> lúc @Model.Luot.ConfirmedAtUtc?.ToString("yyyy-MM-dd HH:mm:ss") UTC
        (người xác nhận:
        @* 🔒 TÊN (tra ở app service) thay vì GUID; không tra được ⇒ nói RÕ, không đoán.
           📌 Neo ASCII `[DOISOAT-NGUOI-XAC-NHAN]` để bộ đo khẳng định **ĐÚNG người** — không đo bằng
           chuỗi "admin" trần (⛔ bài học §5.2: `>admin<` còn khớp `<option>` của dropdown tài khoản). *@
        <code class="text-muted">[DOISOAT-NGUOI-XAC-NHAN]</code>
        @if (!string.IsNullOrWhiteSpace(Model.Luot.ConfirmedByName))
        {
            <strong>@Model.Luot.ConfirmedByName</strong>
        }
        else
        {
            <code title="Không tra được tên từ AbpUsers — GUID vẫn là nguồn sự thật">@Model.Luot.ConfirmedByUserId</code>
            <span class="small">(không tra được tên)</span>
        }).
        <div>Ghi chú: @Model.Luot.ConfirmNote</div>
        <div class="small text-muted">Cảnh báo đã đóng. Tồn kho/sổ cái <strong>KHÔNG</strong> bị sửa — các dòng lệch vẫn phải xử lý riêng.</div>
    </div>
}
else if (Model.Luot.ChoXacNhan)
{
    <div class="alert alert-warning" id="doisoat-xac-nhan">
        <strong>Lượt này ĐANG CHỜ XÁC NHẬN.</strong>
        Chính sách `Recon.Mismatch.Action = RequireConfirmation` ⇒ cần người có quyền
        <code>eCommerce.Reconciliation.Confirm</code> xác nhận để <strong>đóng cảnh báo</strong>.
        🔒 Xác nhận <strong>KHÔNG</strong> sửa tồn kho và <strong>KHÔNG</strong> sinh bút toán điều chỉnh.
        <form method="post" asp-action="XacNhan" class="row g-1 mt-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="reconRunId" value="@Model.Luot.Id" />
            <div class="col-12 col-md-8">
                <input class="form-control form-control-sm" name="ghiChu" required maxlength="1024"
                       placeholder="Vì sao chấp nhận lệch này (BẮT BUỘC — audit)" />
            </div>
            <div class="col-12 col-md-4">
                <button type="submit" class="btn btn-sm btn-danger w-100">Xác nhận &amp; đóng cảnh báo</button>
            </div>
        </form>
    </div>
}

@if (Model.DongLech.TotalCount == 0)
{
    <div class="alert alert-success">
        <strong>Không có dòng lệch nào</strong> khớp bộ lọc.
        @if (chiChuaXuLy)
        {
            <span>Đây là tin <strong>tốt</strong>: mọi dòng lệch của lượt này đã được xử lý. </span>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Kho</th>
                    <th>SKU</th>
                    <th class="text-end" title="Ảnh chụp OnHand lúc quét">Tồn (OnHand)</th>
                    <th class="text-end" title="Tổng CÓ DẤU của sổ cái (nguồn sự thật) lúc quét">Sổ cái</th>
                    <th class="text-end" title="OnHand − TongSoCai; dấu cho biết lệch về phía nào">Lệch</th>
                    <th>Vượt ngưỡng</th>
                    <th>Trạng thái xử lý</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.DongLech.Items)
                {
                    <tr class="@(d.VuotNguong && !d.DaXuLy ? "table-warning" : "")">
                        <td>@(d.WarehouseCode ?? d.WarehouseId.ToString())</td>
                        <td><code>@d.Sku</code></td>
                        <td class="text-end">@d.OnHand</td>
                        <td class="text-end">@d.TongSoCai</td>
                        <td class="text-end @(d.ChenhLech < 0 ? "text-danger" : (d.ChenhLech > 0 ? "text-primary" : ""))">
                            @* 🔒 Giữ DẤU: âm = hệ thống ghi THIẾU so với sổ; dương = ghi THỪA. *@
                            @(d.ChenhLech > 0 ? "+" : "")@d.ChenhLech
                        </td>
                        <td>
                            @if (d.VuotNguong)
                            {
                                <span class="badge bg-danger">vượt</span>
                            }
                            else
                            {
                                <span class="text-muted small">dưới ngưỡng</span>
                            }
                        </td>
                        <td>
                            @if (d.DaXuLy)
                            {
                                @* ③ Dòng ĐÃ xử lý ⇒ KHÔNG hiện form (gọi lại là no-op, không ghi đè bằng chứng). *@
                                <div class="small">
                                    <span class="badge bg-success">đã xử lý</span>
                                    <div class="text-muted">
                                        @d.XuLyLucUtc?.ToString("yyyy-MM-dd HH:mm") · <strong>@d.NguoiXuLy</strong>
                                    </div>
                                    <div>@d.LyDoXuLy</div>
                                </div>
                            }
                            else
                            {
                                <form asp-action="XuLyLech" method="post" class="row g-1">
                                    @* 🚨 BẮT BUỘC: thiếu token ⇒ POST trả 400 (bài học vòng 86). *@
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="dongLechId" value="@d.Id" />
                                    <input type="hidden" name="reconRunId" value="@Model.Luot.Id" />
                                    <div class="col-12 col-md-4">
                                        <input class="form-control form-control-sm" name="nguoiXuLy"
                                               placeholder="Người xử lý" required maxlength="256" />
                                    </div>
                                    <div class="col-12 col-md-5">
                                        <input class="form-control form-control-sm" name="lyDo"
                                               placeholder="Lý do (bắt buộc — audit)" required maxlength="1024" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <button type="submit" class="btn btn-sm btn-primary w-100">Đánh dấu đã xử lý</button>
                                    </div>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">
        Tổng @Model.DongLech.TotalCount dòng · trang @trang.
        @* 🔒 Nói RÕ vì sao không có ô sửa số đo — nếu không, người dùng sẽ đi tìm và tự sửa DB. *@
        <em>Tồn/Sổ cái/Lệch là <strong>ảnh chụp tại thời điểm quét</strong> nên không sửa được: sửa là phá bằng chứng đối soát.</em>
    </p>

    @* 🆕 `S7` — PHÂN TRANG (nợ `rec-001` §18.7 #2: trước đây trần 200 dòng **cắt bớt mà không nói**).
       📌 `TotalCount` là **tổng thật** ⇒ khi tổng > một trang, người dùng **thấy** là còn dòng khác. *@
    var tongTrang = (int)Math.Ceiling(Model.DongLech.TotalCount / (double)soMoiTrang);
    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">[DOISOAT-PHAN-TRANG] Tổng <strong>@Model.DongLech.TotalCount</strong> dòng · trang @trang/@(Math.Max(1, tongTrang))</span>
        <div>
            @if (trang > 1)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-action="ChiTiet"
                   asp-route-id="@Model.Luot.Id" asp-route-chiChuaXuLy="@chiChuaXuLy" asp-route-trang="@(trang - 1)">« Trước</a>
            }
            @if (trang < tongTrang)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-action="ChiTiet"
                   asp-route-id="@Model.Luot.Id" asp-route-chiChuaXuLy="@chiChuaXuLy" asp-route-trang="@(trang + 1)">Sau »</a>
            }
        </div>
    </div>
}
