@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@model List<eCommerce.Customers.CustomerDto>
@{
    PageLayout.Content.Title = "Khách hàng";
    PageLayout.Content.BreadCrumb.Add("Trang chủ");
    PageLayout.Content.BreadCrumb.Add("Khách hàng");

    var tuKhoa = ViewBag.TuKhoa as string;
    var thongBao = TempData["ThongBaoKhach"] as string;
    var loi = TempData["LoiKhach"] as string;
    // 🔑 PHÂN TRANG (`S3`) — bốn con số này do controller tính (kẹp `trang` theo `tongSo`), view **không** tự suy:
    // 📌 nếu view tự chia trang thì hai nơi có thể lệch nhau, và lệch ở đây nghĩa là **liên kết trang trỏ sai**.
    var trang = ViewBag.Trang is int t ? t : 1;
    var soTrang = ViewBag.SoTrang is int s ? s : 1;
    var tongSo = ViewBag.TongSo is int n ? n : 0;
    var soDongMotTrang = ViewBag.SoDongMotTrang is int d ? d : 20;
}

@*
    CUS-001 - HO SO KHACH HANG.

    DAY LA DU LIEU CA NHAN (Luat Bao ve du lieu ca nhan 91/2025/QH15) - va do la dieu quyet dinh
    man hinh nay trong nhu no trong:
      - CHI hien truong CAN cho cong viec: ten, email, dien thoai, trang thai chan;
      - KHONG hien dia chi day du, lich su don, hay bat ky truong nao khong phuc vu cau hoi
        "khach nay la ai, co dang bi chan khong".

    NGUYEN TAC: mot man hinh hien NHIEU HON muc can thiet la mot RO RI - ke ca khi nguoi xem CO quyen.
    Va no KHONG CO TRIEU CHUNG NAO: khong loi, khong log, chi la du lieu o noi khong can.

    NO DA GHI (CUS-001) - man hinh KHONG gia vo co:
      - CHUA co xuat du lieu ca nhan cho chinh chu (quyen truy cap/xoa theo Luat 91/2025/QH15);
      - CHUA co so dia chi (entity Address KHONG TON TAI trong AddressHub);
      - DA co phan trang o S3 (truoc do: tran cung 100 ho so/lan va KHONG co tong so).

    GHI CHU KY THUAT: KHONG duoc viet ky hieu mo/dong chu thich Razor LONG NHAU trong khoi nay.
    Razor khong ho tro long nhau: no ket thuc o ky hieu dong DAU TIEN va phan con lai thanh MA.
    Do dung la loi RZ1003 da vap o vong 20.
*@

@if (!string.IsNullOrWhiteSpace(thongBao))
{
    <div class="alert alert-success">@thongBao</div>
}
@if (!string.IsNullOrWhiteSpace(loi))
{
    @* Loi hien DUNG ma + thong diep (controller da bat BusinessException).
       Ly do chan/go chan la BAT BUOC (audit, ADR-04): o day nguoi dung BIET minh thieu gi. *@
    <div class="alert alert-danger">@loi</div>
}

<div class="alert alert-secondary">
    <strong>Dữ liệu cá nhân.</strong> Màn hình này chỉ hiện thông tin cần cho công việc
    (theo Luật Bảo vệ dữ liệu cá nhân <strong>91/2025/QH15</strong>).
    Chưa có <em>xuất dữ liệu cho chính chủ</em> và chưa có <em>sổ địa chỉ</em> (nợ đã ghi ở <code>CUS-001</code>).
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label">Tìm theo tên / email / điện thoại</label>
                <input class="form-control" name="tuKhoa" value="@tuKhoa" placeholder="(để trống = 100 hồ sơ gần nhất)" />
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary w-100" type="submit">Tìm</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        @* 🔑 TONG SO + TRANG HIEN TAI (`S3`) — 📌 mot man hinh *"khong biet con bao nhieu"* voi du lieu ca nhan
           dan toi hai hanh vi deu sai: tuong da xem het (bo sot khach dang bi chan), hoac nang tran de keo ca bang.
           ✅ Mot con so la du de tra loi cau hoi do. *@
        <strong>Hồ sơ khách (<span id="tong-so-khach">@tongSo</span>)</strong>
        <span class="text-muted small">
            <span id="trang-hien-tai">trang @trang / @soTrang</span>
            · @soDongMotTrang hồ sơ / trang
        </span>
    </div>
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <p class="p-3 mb-0 text-muted" id="khong-co-ho-so">
                Không có hồ sơ nào khớp.
                @if (!string.IsNullOrWhiteSpace(tuKhoa))
                {
                    <a asp-action="Index">Xoá từ khoá</a>
                }
            </p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>Email</th>
                        <th>Điện thoại</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model)
                    {
                        <tr>
                            <td>@k.Name</td>
                            <td class="text-muted small">@k.Email</td>
                            <td class="text-muted small">@k.Phone</td>
                            <td>
                                @if (!k.DungDuoc)
                                {
                                    <span class="badge bg-danger" title="DungDuoc = false: khách KHÔNG dùng được (đang chặn)">Đang chặn</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Bình thường</span>
                                }
                            </td>
                            <td class="text-end">
                                @* 🚨 XUAT DU LIEU CA NHAN (Luat 91/2025/QH15) - quyen TRUY CAP cua chu the.
                                   🔑 VI SAO LA LIEN KET (khong phai form POST): day la thao tac CHI DOC
                                   (khong doi trang thai) => GET la dung ngu nghia HTTP.
                                   🔒 VA QUYEN NAM O `CustomerAppService` (`Customers.Manage`) - lop bao ve
                                   THAT, khong phai o day. *@
                                @* 🚨 **LY DO XUAT LA BAT BUOC** (`CUS-001` §26) — 🔑 Luat **91/2025/QH15** cho khach
                                   quyen biet **VI SAO** du lieu cua ho bi xuat.
                                   ⚠️ **required** o client chi la **tien nghi**; 🔒 guard **THAT** nam o
                                   `CustomerAppService.XuatDuLieuCaNhanAsync` (📌 API/script cung di qua do).
                                   🔑 Day la **form GET** (khong phai POST): thao tac **chi doc** ⇒ 📌 dung ngu
                                   nghia HTTP, va khong can anti-forgery token. *@
                                <form method="get" asp-action="XuatDuLieu" class="d-inline-flex align-items-center gap-1">
                                    <input type="hidden" name="id" value="@k.Id" />
                                    <input class="form-control form-control-sm" style="width: 190px;"
                                           name="lyDo" placeholder="Lý do xuất (bắt buộc)" required
                                           title="Luat 91/2025/QH15: phai ghi VI SAO xuat du lieu cua khach" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit"
                                            title="Tải toàn bộ dữ liệu cá nhân của khách này (Luat 91/2025/QH15) - TÀI LIỆU MẬT">
                                        Xuất dữ liệu
                                    </button>
                                </form>
                                @if (!k.DungDuoc)
                                {
                                    <form method="post" asp-action="MoChan" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@k.Id" />
                                        @* Ly do BAT BUOC: 6 thang sau phai biet VI SAO go chan (audit).
                                           required o client la tien; guard THAT nam o entity. *@
                                        <input class="form-control form-control-sm d-inline-block" style="width: 220px;"
                                               name="lyDo" placeholder="Lý do gỡ chặn (bắt buộc)" required />
                                        <button class="btn btn-sm btn-outline-success" type="submit">Gỡ chặn</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-action="Chan" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@k.Id" />
                                        <input class="form-control form-control-sm d-inline-block" style="width: 220px;"
                                               name="lyDo" placeholder="Lý do chặn (bắt buộc)" required />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Chặn</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    @* 🔑 THANH PHAN TRANG (`S3`) — 📌 **liên kết thuần server** (`?trang=N` + `?tuKhoa=`), KHÔNG JavaScript:
       🔒 nhờ vậy probe HTTP kiểm được *"trang 2 có dữ liệu KHÁC trang 1"* — nếu phân trang bằng JS thì cổng
       E2E (đọc HTML thật) **không bao giờ** thấy được hành vi đó.
       ⚠️ `tuKhoa` phải mang theo: bỏ nó là **mất bộ lọc khi bấm sang trang** (người dùng thấy khách khác với
       từ khoá mình vừa gõ — im lặng, không lỗi). *@
    @if (soTrang > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center" id="thanh-phan-trang">
            <div>
                @if (trang > 1)
                {
                    <a id="lien-ket-trang-truoc" class="btn btn-sm btn-outline-secondary"
                       asp-action="Index" asp-route-trang="@(trang - 1)" asp-route-tuKhoa="@tuKhoa">‹ Trang trước</a>
                }
                else
                {
                    <span id="lien-ket-trang-truoc" class="btn btn-sm btn-outline-secondary disabled">‹ Trang trước</span>
                }
            </div>
            <span class="text-muted small">Trang @trang / @soTrang</span>
            <div>
                @if (trang < soTrang)
                {
                    <a id="lien-ket-trang-sau" class="btn btn-sm btn-outline-secondary"
                       asp-action="Index" asp-route-trang="@(trang + 1)" asp-route-tuKhoa="@tuKhoa">Trang sau ›</a>
                }
                else
                {
                    <span id="lien-ket-trang-sau" class="btn btn-sm btn-outline-secondary disabled">Trang sau ›</span>
                }
            </div>
        </div>
    }
</div>

<div class="card">
    <div class="card-header"><strong>Tạo hồ sơ khách</strong></div>
    <div class="card-body">
        <form method="post" asp-action="TaoKhach" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label class="form-label">Tên (bắt buộc)</label>
                <input class="form-control" name="ten" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Email</label>
                <input class="form-control" type="email" name="email" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Điện thoại</label>
                <input class="form-control" name="dienThoai" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" type="submit">Tạo hồ sơ</button>
            </div>
        </form>
    </div>
</div>

@* 🚨 LIÊN KẾT TỚI NHẬT KÝ KIỂM TOÁN (`CUS-001` §23) — 🔑 để "bằng chứng" có **LỐI VÀO**.
   ⚠️ Một bằng chứng không ai tìm thấy thì **KHÔNG PHỤC VỤ** câu hỏi nào (nợ đã ghi ở §22.6 #1). *@
<p class="mt-3 mb-0">
    <a asp-action="NhatKy" class="btn btn-sm btn-outline-secondary">
        Nhật ký xuất dữ liệu cá nhân
    </a>
    <span class="text-muted small ms-2">
        Ai đã xuất dữ liệu của khách, khi nào (Luật 91/2025/QH15)
    </span>
</p>

<p class="text-muted small mt-3 mb-0">[KHACHHANG-MAN-HINH]</p>
