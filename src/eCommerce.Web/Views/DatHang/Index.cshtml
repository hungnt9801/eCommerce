@using eCommerce.Web.Controllers
@model DatHangTrangDto
@{
    Layout = null;
}
@*
    🚨 GIỎ HÀNG → ĐẶT HÀNG TRÊN WEB (WEB-001 — mảnh cuối của GĐ1 về phía người dùng).
    📌 MỘT view dùng cho HAI trạng thái: **biểu mẫu** (chưa đặt) và **kết quả** (đã đặt xong) — giảm số tệp,
       và phép kiểm chứng chỉ phải đi qua MỘT đường render.
    ⚠️ Mọi giá trị qua Razor `@` (tự HTML-encode). Tổng tiền hiển thị **nguyên văn từ sổ giải trình** (không tính lại).
*@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đặt hàng</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 2rem; color: #222; }
        h1 { font-size: 1.3rem; }
        table { border-collapse: collapse; max-width: 40rem; margin-top: .6rem; }
        th, td { border: 1px solid #ccc; padding: .4rem .6rem; text-align: left; }
        th { background: #f3f3f3; }
        .so { text-align: right; }
        .rong { padding: 1rem; background: #fffbe6; border: 1px solid #e6d38a; max-width: 40rem; }
        .loi { padding: 1rem; background: #fdecea; border: 1px solid #e6a39a; max-width: 40rem; }
        .ok { padding: 1rem; background: #eaf7ec; border: 1px solid #a3d8ae; max-width: 40rem; }
        .ghichu { color: #666; font-size: .85rem; max-width: 40rem; }
        label { display: inline-block; min-width: 9rem; }
        input, select { padding: .25rem; }
    </style>
</head>
<body>
    <h1>Đặt hàng</h1>

    @if (Model.Loi is not null)
    {
        <div class="loi" id="loi"><strong>Không đặt được:</strong> @Model.Loi</div>
    }

    @if (Model.DaDat)
    {
        <div class="ok" id="ket-qua">
            <strong>ĐÃ ĐẶT HÀNG.</strong>
            <table id="bang-ket-qua">
                <tr><th>Số đơn</th><td id="so-don">@Model.SoDon</td></tr>
                @if (Model.DonId.HasValue)
                {
                    <tr><th>Quản lý</th><td><a id="lien-ket-quan-ly-don" href="@Url.Action("ChiTiet", "DonHang", new { id = Model.DonId })">Xem &amp; xử lý đơn này</a></td></tr>
                }
                <tr><th>Trạng thái</th><td id="trang-thai">@Model.TrangThai</td></tr>
                <tr><th>Tổng tiền (từ sổ giải trình)</th><td class="so" id="tong-tien">@Model.TongTien.ToString("N0")</td></tr>
                <tr><th>Tiền tệ</th><td id="tien-te">@Model.TienTe</td></tr>
                <tr><th>Khoá checkout</th><td id="khoa-checkout">@Model.KhoaCheckout</td></tr>
            </table>
            <p class="ghichu">Số tiền lấy <strong>nguyên văn</strong> từ sổ giải trình — <em>không</em> tính lại ở tầng UI.</p>
        </div>
    }

    @if (Model.KhoList.Count == 0)
    {
        @* 🚨 CA RỖNG: chưa có kho nào ⇒ không thể đặt hàng. Phải nói RÕ, không để biểu mẫu trống khó hiểu. *@
        <div class="rong" id="trong">
            <strong>Chưa có kho nào đang hoạt động.</strong>
            <div>Cần tạo kho (và bảng giá) trước khi đặt hàng.</div>
        </div>
    }
    else
    {
        <form method="post" id="form-dat-hang">
            @* 🔐 Chống giả mạo: token do chính trang này phát ra (đo được: form đăng nhập cũng dùng cùng cơ chế). *@
            @* 🚨 **TOKEN CHỐNG GIẢ MẠO THẬT** — KHÔNG tự đặt GUID ngẫu nhiên: ABP bật kiểm anti-forgery cho POST
               ⇒ token giả ⇒ **HTTP 400** (đã ĐO được ở vòng 65: POST trả 400, trang chỉ hiện form).
               📌 `@Html.AntiForgeryToken()` phát token **khớp cookie** do chính máy chủ cấp. *@
            @Html.AntiForgeryToken()
            <div><label for="KhoId">Kho</label>
                <select id="KhoId" name="KhoId">
                    @foreach (var k in Model.KhoList)
                    {
                        <option value="@k.Id">@k.Code — @k.Name</option>
                    }
                </select>
            </div>
            <div><label for="Kenh">Kênh</label><input id="Kenh" name="Kenh" value="@Model.Kenh" /></div>
            @* 🚨 **KHÁCH CỦA ĐƠN** (`CUS-001` ADR-04 — `S3`).
               🔑 VI SAO O CHON NAY TON TAI: truoc `S3` duong web KHONG dat `CustomerId` cho don
               ⇒ don web "khong thuoc ve ai", va 🔒 cua "khach bi chan khong duoc mua" KHONG THE phat huy
               tac dung o day (khong co khach de kiem).
               ⚠️ O CHON NAY KHONG PHAI LA CUA: khach dang CHAN van hien (co nhan) va van gui duoc
               ⇒ 🔒 guard THAT nam o `CuaKiemKhachGiaoDich` (app service) — thuoc tinh `disabled` trong HTML
               thi ai cung sua duoc bang tay.
               📌 Chon TRONG = khach vang lai (mac dinh, hop le — ADR-03). *@
            @if (Model.CoQuyenChonKhach)
            {
                <div>
                    <label for="KhachId">Khách</label>
                    <select id="KhachId" name="KhachId">
                        <option value="">— Khách vãng lai —</option>
                        @foreach (var k in Model.KhachList)
                        {
                            if (Model.KhachId == k.Id)
                            {
                                <option value="@k.Id" selected>@k.Ten@(k.DungDuoc ? "" : " (ĐANG CHẶN)")</option>
                            }
                            else
                            {
                                <option value="@k.Id">@k.Ten@(k.DungDuoc ? "" : " (ĐANG CHẶN)")</option>
                            }
                        }
                    </select>
                    @if (Model.TongSoKhach > Model.KhachList.Count)
                    {
                        <span class="ghichu" id="gioi-han-o-chon-khach">
                            (chỉ hiện @Model.KhachList.Count / @Model.TongSoKhach khách — tra đủ ở mục Khách hàng)
                        </span>
                    }
                </div>
            }
            else
            {
                @* ⚠️ KHONG im lang: neu nguoi dung khong co quyen xem ho so khach thi phai NOI RO, 📌 neu khong
                   ho se tuong he thong "khong co khach nao" va dat don cho khach vang lai ma khong biet. *@
                <div>
                    <label>Khách</label>
                    <span class="ghichu" id="khong-co-quyen-chon-khach">
                        Không có quyền xem hồ sơ khách ⇒ đơn sẽ là <strong>khách vãng lai</strong>.
                    </span>
                </div>
            }
                            @* 🚨 §87: giỏ ĐANG LƯU (cookie) — chỉ hiện khi có dữ liệu; kèm nút XOÁ GIỎ (GET /DatHang/XoaGio). *@
                @if (!string.IsNullOrWhiteSpace(Model.TomTatGio))
                {
                    <div id="gio-da-luu">Giỏ đang lưu: <strong id="tom-tat-gio">@Model.TomTatGio</strong>
                        <a id="nut-xoa-gio" href="@Url.Action("XoaGio", "DatHang")">Xoá giỏ</a>
                    </div>
                }
<div><label for="Sku">SKU</label><input id="Sku" name="Sku" value="@Model.Sku" /></div>

                @* 🚨 GIỎ NHIỀU Ô NHẬP (§82): dòng 2 và 3 — để TRỐNG nếu không dùng. Ghép ở SERVER (không JS). *@
                @* 🚨 §89: dòng 2/3 nay **CÓ ĐIỀU KIỆN** theo `SoDong` — nếu không, nút "Bớt dòng" chỉ ẩn được dòng 4/5 (khiếm khuyết thật phát hiện ở vòng 106). *@
                @if (Model.SoDong >= 2)
                {
                    <div><label for="Sku2">SKU dòng 2</label><input id="Sku2" name="Sku2" value="@Model.Sku2" /></div>
                    <div><label for="SoLuong2">SL dòng 2</label><input id="SoLuong2" name="SoLuong2" type="number" min="1" value="@Model.SoLuong2" /></div>
                }
                @if (Model.SoDong >= 3)
                {
                    <div><label for="Sku3">SKU dòng 3</label><input id="Sku3" name="Sku3" value="@Model.Sku3" /></div>
                    <div><label for="SoLuong3">SL dòng 3</label><input id="SoLuong3" name="SoLuong3" type="number" min="1" value="@Model.SoLuong3" /></div>
                }

                @* 🚨 §89: SỐ DÒNG + DÒNG 4/5. 📌 Nút là **LIÊN KẾT** `?soDong=N` (thuần server, KHÔNG JS) ⇒ probe HTTP kiểm được. *@
                <input type="hidden" id="SoDong" name="SoDong" value="@Model.SoDong" />
                <p id="dieu-huong-dong">
                    @if (Model.SoDong >= 4)
                    {
                        <div><label for="Sku4">SKU dòng 4</label><input id="Sku4" name="Sku4" value="@Model.Sku4" /></div>
                        <div><label for="SoLuong4">SL dòng 4</label><input id="SoLuong4" name="SoLuong4" type="number" min="1" value="@Model.SoLuong4" /></div>
                    }
                    @if (Model.SoDong >= 5)
                    {
                        <div><label for="Sku5">SKU dòng 5</label><input id="Sku5" name="Sku5" value="@Model.Sku5" /></div>
                        <div><label for="SoLuong5">SL dòng 5</label><input id="SoLuong5" name="SoLuong5" type="number" min="1" value="@Model.SoLuong5" /></div>
                    }
                    @if (Model.SoDong < 5)
                    {
                        <a id="nut-them-dong" href="/DatHang?soDong=@(Model.SoDong + 1)">Thêm dòng</a>
                    }
                    @if (Model.SoDong > 1)
                    {
                        <a id="nut-bot-dong" href="/DatHang?soDong=@(Model.SoDong - 1)">Bớt dòng</a>
                    }
                </p>
            <div><label for="SoLuong">Số lượng</label><input id="SoLuong" name="SoLuong" type="number" min="1" value="@Model.SoLuong" /></div>
            <div><label for="Thue">Thuế suất (0.1 = 10%)</label><input id="Thue" name="Thue" value="@Model.Thue" /></div>
            <div style="margin-top:.6rem">
                <button type="submit" id="nut-dat-hang">Đặt hàng</button>
                <input type="hidden" name="KhoaCheckout" value="@Model.KhoaCheckout" />
            </div>
        </form>
    }

    <p class="ghichu">
        Nguồn: <code>ICheckoutAppService.TinhVaGiuChoAsync</code> ⇒ <code>IDonHangAppService.TaoTuCheckoutAsync</code>
        — **cùng** app service đã kiểm chứng ở tầng API (`SAL-001`/`SAL-002`). 📌 <strong>Khoá checkout</strong> sinh
        <strong>một lần</strong> ở trang này và mang theo trong form ⇒ bấm hai lần <strong>không</strong> tạo hai đơn.
    </p>
</body>
</html>
