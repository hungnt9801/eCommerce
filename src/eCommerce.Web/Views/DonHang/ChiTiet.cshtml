@using eCommerce.Application.Contracts.Sales
@model DonHangDto
@{
    Layout = null;
}
@*
    🚨 QUẢN LÝ ĐƠN TRÊN UI (WEB-001). 📌 `Layout = null`: trang tự chứa ⇒ phép kiểm chứng tập trung vào đường dữ liệu.
    🔐 **MỖI form POST đều có `@Html.AntiForgeryToken()`** — thiếu là ABP trả 400 (bài học vòng 65 · 86 · `tools/README-probe.md` Phần E).
*@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đơn hàng</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 2rem; color: #222; }
        h1 { font-size: 1.3rem; }
        table { border-collapse: collapse; max-width: 40rem; }
        th, td { border: 1px solid #ccc; padding: .4rem .6rem; text-align: left; }
        th { background: #f3f3f3; }
        form { display: inline; }
        .ghichu { color: #666; font-size: .85rem; max-width: 40rem; }
    </style>
</head>
<body>
    <h1>Đơn hàng</h1>

    <table id="bang-don">
        <tr><th>Số đơn</th><td id="so-don">@Model.Number</td></tr>
        <tr><th>Trạng thái</th><td id="trang-thai">@Model.Status</td></tr>
        <tr><th>Tổng tiền</th><td id="tong-tien">@Model.GrandTotal.ToString("N0")</td></tr>
        <tr><th>Khoá checkout</th><td id="khoa">@(Model.CheckoutIdempotencyKey ?? "(không có)")</td></tr>
    </table>

    @* 🆕 `SAL-003` #7 (24/10/2026) — **4 TRỤC + LỊCH SỬ**. 🔒 Chỉ ĐỌC: thay đổi trạng thái đi qua
       `IOrderStatusAppService` (permission riêng theo trục). 📌 `trang-thai` ở bảng trên là giá trị SUY RA. *@
    <h2>Trạng thái 4 trục</h2>
    <table id="bang-truc">
        <tr><th>Trục</th><th>Giá trị</th><th>Version</th></tr>
        <tr><td>Thực hiện</td><td id="truc-thuc-hien">@Model.FulfillmentStatus</td><td id="v-thuc-hien">@Model.FulfillmentVersion</td></tr>
        <tr><td>Tài chính</td><td id="truc-tai-chinh">@Model.PaymentStatus</td><td id="v-tai-chinh">@Model.PaymentVersion</td></tr>
        <tr><td>Đối soát</td><td id="truc-doi-soat">@Model.ReconciliationStatus</td><td id="v-doi-soat">@Model.ReconciliationVersion</td></tr>
        <tr><td>Kết thúc</td><td id="truc-ket-thuc">@Model.ReturnStatus</td><td id="v-ket-thuc">@Model.ClosureVersion</td></tr>
        <tr><td>Đã huỷ</td><td id="truc-huy">@(Model.IsCancelled ? "Có" : "Không")</td><td id="v-dong">RowVersion @Model.RowVersion</td></tr>
    </table>
    <p class="ghichu">
        Trạng thái ở bảng trên (<span id="trang-thai-suy-ra">@Model.Status</span>) được <strong>suy ra</strong> từ 4 trục
        — không có cột nào cho phép sửa tay. Bốn trục <strong>trực giao</strong>: ví dụ đơn COD có
        “Thực hiện = Delivered” mà “Tài chính = Unpaid”.
    </p>

    <h2>Lịch sử trạng thái</h2>
    @if (ViewBag.CoQuyenLichSu == true)
    {
        var lichSu = (ViewBag.LichSu as IEnumerable<OrderStatusHistoryDto>) ?? Enumerable.Empty<OrderStatusHistoryDto>();

        if (!lichSu.Any())
        {
            <p class="ghichu" id="lich-su-rong">Chưa có lần chuyển trạng thái nào.</p>
        }
        else
        {
            <table id="bang-lich-su">
                <tr><th>Lúc (UTC)</th><th>Trục</th><th>Từ → Đến</th><th>Người</th><th>Lý do</th><th>Version</th></tr>
                @foreach (var dong in lichSu)
                {
                    <tr>
                        <td>@dong.OccurredAtUtc.ToString("u")</td>
                        <td>@dong.Axis</td>
                        <td>@dong.FromStatus → @dong.ToStatus</td>
                        <td>@dong.ActorType</td>
                        <td>@dong.ReasonCode</td>
                        <td>@dong.VersionAfter</td>
                    </tr>
                }
            </table>
            <p class="ghichu">Nhật ký là <strong>append-only</strong> — không sửa/xoá được (chứng từ khi tranh chấp).</p>
        }
    }
    else
    {
        <p class="ghichu" id="lich-su-khong-quyen">Bạn không có quyền xem lịch sử trạng thái (<code>eCommerce.Orders.History.View</code>).</p>
    }

    @* Hai hành động đã ĐO chạy đúng trên đơn định dạng WEB-… (§65 · §69) *@
    <form method="post" action="/DonHang/XacNhan/@Model.Id">
        @Html.AntiForgeryToken()
        <button type="submit" id="nut-xac-nhan">Xác nhận</button>
    </form>
    <form method="post" action="/DonHang/Huy/@Model.Id">
        @Html.AntiForgeryToken()
        <button type="submit" id="nut-huy">Huỷ đơn</button>
    </form>
    @* Trả hàng: cần KHO nhận hàng trả ⇒ có ô nhập. API đã đo chạy đúng ở §69 (kể cả phiếu TH-{số đơn}-{n}). *@
    <form method="post" action="/DonHang/TraHang/@Model.Id">
        @Html.AntiForgeryToken()
        <label for="o-kho-tra">Kho nhận hàng trả</label>
        <input id="o-kho-tra" name="khoId" required />
        <button type="submit" id="nut-tra-hang">Trả hàng</button>
    </form>

    @* 🆕 `S14` phần E (`SAL-006` §32) — LỐI VÀO **MÀN HÌNH PHIẾU TRẢ (RMA)**.
       🔑 Dùng `Url.Action` (KHÔNG viết cứng href): đổi route/controller thì link đổi theo, và `MenuDieuHuongTests`
       cấm URL của menu bị viết cứng trong view. 📌 Nút POST ở trên là **đường cũ** (`TraHangAsync`, đi đủ ba cạnh
       nhưng không có phiếu để duyệt/nhận/đóng); link này mở quy trình RMA **có phiếu** và có chứng từ kho. *@
    <p class="ghichu">
        <a id="lien-ket-phieu-tra" href="@Url.Action("Index", "TraHang", new { donId = Model.Id })">Trả hàng</a>
        — mở <strong>phiếu trả (RMA)</strong> của đơn này: duyệt / từ chối / nhận hàng về kho / đóng / ghi nhận hoàn tiền.
    </p>

    <p class="ghichu">
        Xác nhận ⇒ <strong>xuất kho</strong> (<code>OnHand</code> và <code>Reserved</code> cùng giảm, <code>Available</code> không đổi).
        Huỷ ⇒ <strong>nhả chỗ ngay</strong>. Cả hai dùng <code>IDonHangAppService</code> — cùng app service với API.
    </p>
</body>
</html>
