{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-write-scope.mjs"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-shell.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/bao-orch.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent-start.mjs"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-agent-stop.mjs"
            ],
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pwsh -File tools/agents/phien.ps1 *)",
      "PowerShell(pwsh -File tools/agents/phien.ps1 *)",
      "Bash(pwsh -File tools/agents/test-phien.ps1)",
      "PowerShell(pwsh -File tools/agents/test-phien.ps1)",
      "Bash(pwsh -File tools/kiem-link-tai-lieu.ps1)",
      "PowerShell(pwsh -File tools/kiem-link-tai-lieu.ps1)",
      "Bash(npm --prefix tools run check:mermaid)",
      "PowerShell(npm --prefix tools run check:mermaid)",
      "Bash(node --test .claude/hooks/test/hooks.test.mjs)",
      "PowerShell(node --test .claude/hooks/test/hooks.test.mjs)",
      "Bash(pwsh -File tools/agents/check-feature-doc.ps1 *)",
      "PowerShell(pwsh -File tools/agents/check-feature-doc.ps1 *)",
      "Bash(pwsh -File tools/agents/check-agent-artifact.ps1 *)",
      "PowerShell(pwsh -File tools/agents/check-agent-artifact.ps1 *)",
      "Bash(git add -- *)",
      "PowerShell(git add -- *)",
      "Bash(git commit -m *)",
      "PowerShell(git commit -m *)"
    ],
    "deny": [
      "Bash(git config --global *)",
      "PowerShell(git config --global *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(dotnet ef database update)",
      "Bash(dotnet ef database update *)",
      "PowerShell(dotnet ef database update)",
      "PowerShell(dotnet ef database update *)"
    ]
  }
}
