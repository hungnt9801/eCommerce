<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Cho phép ghim version của package BẮC CẦU (dùng để vá lỗ hổng của dependency gián tiếp). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!--
    ABP 10.7.0 = bản ổn định mới nhất tại thời điểm dựng khung (phát hành 06/10/2026).
    ABP 10.x chạy trên .NET 10 (global.json: SDK 10.0.400).

    ✅ ĐÃ KIỂM CHỨNG: `dotnet restore` và `dotnet build` chạy thành công với đúng các version dưới đây
       (build 0 error / 0 warning; test 20/20 pass). Nâng version = sửa đúng file này
       (central package management) hoặc chạy `abp update`.

    📌 CÁC PACKAGE Ở ĐÂY LÀ "FRAMEWORK MODULE" CỦA ABP — chúng nằm trong source code ở dạng
       NuGet package (DLL), KHÔNG phải file .cs, nên không thấy khi mở cây thư mục.
       Ứng dụng "dùng" chúng qua [DependsOn] trong module class của từng project.
       Các "APPLICATION MODULE" (Identity, TenantManagement, OpenIddict, Account...) CHƯA được thêm —
       xem docs/abp-modules-plan.md để biết kế hoạch, lệnh và thứ tự cụ thể.
  -->
  <ItemGroup Label="ABP framework (LGPL-3.0)">
    <PackageVersion Include="Volo.Abp.Core" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Account.Application" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Account.Application.Contracts" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.AuditLogging.Domain" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.AuditLogging.Domain.Shared" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.AuditLogging.EntityFrameworkCore" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.BackgroundJobs.Domain" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.BackgroundJobs.Domain.Shared" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.BackgroundJobs.EntityFrameworkCore" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Ddd.Domain.Shared" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Ddd.Domain" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Ddd.Application.Contracts" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Ddd.Application" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.EntityFrameworkCore" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.EntityFrameworkCore.PostgreSql" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Autofac" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.AspNetCore.Mvc" Version="10.7.0" />
    <!-- 🚨 BUG ĐÃ SỬA (chạy thật mới lộ): 2 gói dưới đây BẮT BUỘC với Host làm auth server.
         • Volo.Abp.Identity.AspNetCore: đăng ký SignInManager<IdentityUser>. THIẾU nó thì
           password grant KHÔNG chạy: "No service for type 'SignInManager`1[IdentityUser]' has been registered".
         • Volo.Abp.AspNetCore.Authentication.JwtBearer: đặt DEFAULT CHALLENGE SCHEME. THIẾU nó thì
           gọi API không token trả **500** thay vì **401**:
           "No authenticationScheme was specified, and there was no DefaultChallengeScheme found". -->
    <PackageVersion Include="Volo.Abp.Identity.AspNetCore" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.AspNetCore.Authentication.JwtBearer" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.Application" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.Application.Contracts" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.Domain" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.Domain.Shared" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.EntityFrameworkCore" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Identity.Application.Contracts" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Identity.Domain.Shared" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.OpenIddict.AspNetCore" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.OpenIddict.Domain" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.OpenIddict.Domain.Shared" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.OpenIddict.EntityFrameworkCore" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Application" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Application.Contracts" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Domain" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Domain.Identity" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Domain.OpenIddict" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Domain.Shared" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.EntityFrameworkCore" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.SettingManagement.Application" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.SettingManagement.Application.Contracts" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.SettingManagement.Domain" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.SettingManagement.Domain.Shared" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.SettingManagement.EntityFrameworkCore" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Swashbuckle" Version="10.7.0" />
    <!-- KHÔNG có Volo.Abp.AutoMapper: đã bỏ AutoMapper (map tay) để loại advisory GHSA-rvv3-g6hj-g44x. -->
    <PackageVersion Include="Volo.Abp.EventBus" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.BackgroundWorkers" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.DistributedLocking" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Caching" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Caching.StackExchangeRedis" Version="10.7.0" />
  </ItemGroup>
  <ItemGroup Label="ABP Identity (free module) - auth cơ bản để có user/role/permission">
    <PackageVersion Include="Volo.Abp.Identity.Domain" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Identity.Application" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Identity.EntityFrameworkCore" Version="10.7.0" />
    <PackageVersion Include="Volo.Abp.Identity.HttpApi" Version="10.7.0" />
  </ItemGroup>
  <!--
    GIAI ĐOẠN 1 — UI QUẢN TRỊ (§7.0 #2): `src/eCommerce.Web`.
    ✅ ĐÃ XÁC MINH CÓ THẬT TRÊN nuget.org (hỏi `api.nuget.org/v3-flatcontainer` ngày 15/10/2026),
       KHÔNG đoán: cả hai đều có bản **10.7.0** khớp version ABP đang ghim.

    ⚠️ `Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite` **KHÔNG** có bản 10.7.0 (chuỗi version của nó
       chỉ tới 5.7.0) ⇒ **không** dùng được; chọn **BasicTheme** (miễn phí, LGPL) theo đúng
       "quyết định 8" của kế hoạch (`docs/implementation-plan.md` §2).
  -->
  <ItemGroup Label="ABP MVC UI (free theme + màn hình login) — GĐ1">
    <PackageVersion Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.Basic" Version="10.7.0" />
    <!--
      ⚠️ CHỌN `Volo.Abp.Account.Web` (KHÔNG phải `.OpenIddict`): UI dùng **cookie** của ABP Identity,
         KHÔNG cần làm auth server. Gói `.OpenIddict` kéo theo `Volo.Abp.OpenIddict.AspNetCore`
         ⇒ tiến trình UI trở thành **auth server THỨ HAI** (trùng vai với `eCommerce.HttpApi.Host`)
         trên **cùng DB**: hai nơi cùng quản `OpenIddictApplications`/`OpenIddictTokens`, mỗi nơi một
         bộ chứng chỉ dev khác nhau ⇒ token phát từ UI **không** được Host chấp nhận, và ngược lại.
         Không phải lỗi bảo mật, nhưng là **hai nguồn sự thật** cho cùng một việc — tránh hẳn.
    -->
    <PackageVersion Include="Volo.Abp.Account.Web" Version="10.7.0" />
  </ItemGroup>
  <ItemGroup Label="Third-party — version đã được xác nhận qua `dotnet restore` thật">
    <!-- EF Core runtime được resolve là 10.0.11; Tools/Design phải cùng dòng để tránh lệch. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="DistributedLock.Redis" Version="1.0.1" />
    <!-- Volo.Abp.Swashbuckle 10.7.0 yêu cầu Swashbuckle.AspNetCore >= 10.2.3
         (ghim 9.0.6 ban đầu gây lỗi NU1109 downgrade — đã sửa). -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!--
      VÁ LỖ HỔNG BẮC CẦU: EF Core Tools kéo `System.Security.Cryptography.Xml 9.0.0`,
      bản này có 8 advisory high severity (NU1903) ⇒ build từng có 16 warning.
      Ghim lên 10.0.13 (bản ĐÃ VÁ) — ⚠️ 10.0.12 VẪN còn lỗ hổng (NU1902 moderate + NU1903 high).
         🚨 BẪY ĐÃ GẶP (14/10/2026): project test đặt `ManagePackageVersionsCentrally=false` nên
         **BỎ QUA ghim này** ⇒ resolve 10.0.11 (có lỗ hổng mức CAO) mà KHÔNG ai thấy. Đã ghim tường minh
         trong `test/eCommerce.Tests/eCommerce.Tests.csproj`. Đây là thư viện cho **XMLDSig** (SIGN-001/EINV-001)
         ⇒ lỗ hổng ở đây ảnh hưởng trực tiếp đường ký số.
         📌 Nếu sau khi nâng bản mà build VẪN báo lỗ hổng ở bản CŨ: đó là **cache audit của NuGet** —
         cần xoá HTTP cache của NuGet (`dotnet nuget locals http-cache` + cờ xoá) + xoá `obj/` rồi restore lại.
      Cần CentralPackageTransitivePinningEnabled ở trên.
    -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <!--
    KHÔNG có trong skeleton này (thêm sau bằng `abp add-module` khi có mạng):
      Volo.TenantManagement   -> UI + entity quản tenant (Tenant Management MIỄN PHÍ)
      Volo.OpenIddict.*       -> auth server chuẩn của ABP 10 (thay IdentityServer)
      Volo.Payment            -> PRO module (cần license Team+), chỉ có Stripe/PayPal/Iyzico/Alipay...
      Volo.Abp.OperationRateLimiting -> PRO module (rate limit tầng nghiệp vụ)
    Xem docs/02-abp-license-boundary.md.
  -->
</Project>